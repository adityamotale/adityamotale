---
import '../styles/global.css';

interface ArticleMeta {
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  author?: string;
  article?: ArticleMeta;
}

const {
  title = 'aditya motale ~ an engineer by choice',
  description = 'an engineer by choice',
  image = '/og-image.png',
  imageAlt,
  imageWidth = 1200,
  imageHeight = 630,
  type = 'website',
  publishedTime = Astro.props.article?.publishedTime,
  modifiedTime = Astro.props.article?.modifiedTime,
  tags = Astro.props.article?.tags || [],
  author = Astro.props.article?.author || 'Aditya Motale',
} = Astro.props;

const siteUrl = Astro.site || Astro.url.origin || 'https://adii.fyi';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const socialImageURL = new URL(image, siteUrl);

const resolvedImageAlt = imageAlt || title;
const imageType =
  image.endsWith('.jpg') || image.endsWith('.jpeg')
    ? 'image/jpeg'
    : image.endsWith('.svg')
      ? 'image/svg+xml'
      : 'image/png';

const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description: description,
        url: canonicalURL.toString(),
        image: socialImageURL.toString(),
        datePublished: publishedTime,
        dateModified: modifiedTime || publishedTime,
        author: {
          '@type': 'Person',
          name: author,
          url: siteUrl.toString(),
        },
        publisher: {
          '@type': 'Person',
          name: 'Aditya Motale',
          url: siteUrl.toString(),
        },
        ...(tags.length > 0 ? { keywords: tags.join(', ') } : {}),
        mainEntityOfPage: {
          '@type': 'WebPage',
          '@id': canonicalURL.toString(),
        },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'aditya motale',
        url: canonicalURL.toString(),
        description: description,
        inLanguage: 'en-US',
        publisher: {
          '@type': 'Person',
          name: 'Aditya Motale',
          url: siteUrl.toString(),
          sameAs: [
            'https://github.com/adityamotale',
            'https://x.com/arctic_byte',
            'https://www.linkedin.com/in/aditya-motale',
          ],
        },
      };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    {tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
    <meta name="robots" content="index, follow" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="aditya motale ~ an engineer by choice"
      href="/rss.xml"
    />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Adii" />
    <meta name="application-name" content="Adii" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#232136"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#faf4ed"
    />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="aditya motale" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:secure_url" content={socialImageURL} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:alt" content={resolvedImageAlt} />
    <meta property="og:locale" content="en_US" />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {author && <meta property="article:author" content={author} />}
    {tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@arctic_byte" />
    <meta name="twitter:creator" content="@arctic_byte" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={resolvedImageAlt} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    ></script>
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      (function () {
        const themes = ['moon', 'dawn'];
        const stored =
          typeof localStorage !== 'undefined'
            ? localStorage.getItem('theme')
            : null;
        let theme = stored;
        if (!theme || !themes.includes(theme)) {
          const prefersDark =
            window.matchMedia &&
            window.matchMedia('(prefers-color-scheme: dark)').matches;
          theme = prefersDark ? 'moon' : 'dawn';
        }
        document.documentElement.classList.remove(
          'theme-moon',
          'theme-dawn',
          'theme-default'
        );
        document.documentElement.classList.add(`theme-${theme}`);
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body class="text-rp-text min-h-screen transition-colors duration-200 antialiased pb-12 sm:pb-14">
    <slot />
  </body>
</html>
