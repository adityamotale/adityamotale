---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { formatBlogDate, getAllWriting } from '../../lib/blog';

const writingList = await getAllWriting();
---

<Layout
  title="Writing ~ aditya"
  description="All writings, essays, technical notes, and articles by Aditya."
>
  <main class="w-full max-w-screen-md mx-auto px-4 sm:px-6 pt-8 sm:pt-14 pb-4 sm:pb-6 space-y-6 sm:space-y-8">
    <div id="section-intro">
      <Header />
    </div>

    <section
      id="section-all-writing"
      class="w-full font-mono text-[11px] sm:text-xs leading-relaxed"
    >
      <div class="w-full flex flex-col font-mono">
        {/* Section Header: > ALL WRITING ────── [back to home] ── */}
        <div class="w-full flex items-center overflow-hidden mb-2">
          <span class="text-[var(--color-accent)] font-semibold shrink-0">
            &gt;&nbsp;
          </span>
          <span class="font-bold tracking-wider text-rp-text uppercase shrink-0">
            ALL WRITING
          </span>
          <span class="mx-2 flex-1 border-b border-rp-muted/20" />
          <a
            href="/"
            class="shrink-0 text-rp-subtle hover:text-[var(--color-accent)] transition-colors text-[11px] font-mono lowercase"
          >
            [back to home]
          </a>
          <span class="ml-2 w-3 sm:w-4 border-b border-rp-muted/20 shrink-0" />
        </div>

        {/* Section subtitle */}
        <div class="text-[11px] text-rp-muted/70 pl-3 mb-2">
          <span>// total {writingList.length} articles</span>
        </div>

        {/* Posts list */}
        <div class="pl-3 py-1 flex flex-col space-y-1.5">
          {writingList.map((item) => (
            <div class="group flex items-baseline justify-between gap-3 border-b border-rp-muted/10 py-1.5 last:border-0">
              <a
                href={item.url}
                target={item.isExternal ? '_blank' : undefined}
                rel={item.isExternal ? 'noopener noreferrer' : undefined}
                class="text-rp-subtle hover:text-[var(--color-accent)] transition-colors underline decoration-dotted decoration-rp-muted/50 underline-offset-3 leading-snug flex-1 truncate select-text"
              >
                {item.title}
                {item.isExternal && (
                  <span class="text-[10px] text-rp-muted ml-1 select-none">
                    [ext ↗]
                  </span>
                )}
              </a>
              <span class="shrink-0 text-rp-muted text-[11px] font-mono">
                {formatBlogDate(item.dateStr)}
              </span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <div class="h-[30vh]"></div>

    <Footer />
  </main>
</Layout>
