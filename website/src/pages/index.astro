---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import StatusBar from '../components/StatusBar.astro';
import CodingStats from '../components/CodingStats.astro';
import MonthlyStats from '../components/MonthlyStats.astro';
---

<Layout>
	<main class="w-full max-w-screen-md mx-auto px-4 sm:px-6 py-8 sm:py-14 space-y-6 sm:space-y-8">
		<div id="section-intro">
			<Header />
		</div>

		<section id="section-status">
			<StatusBar />
		</section>

		<section id="section-coding-stats">
			<CodingStats />
		</section>

		<section id="section-monthly-stats">
			<MonthlyStats />
		</section>
	</main>
</Layout>
