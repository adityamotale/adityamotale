---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import StatusBar from '../components/StatusBar.astro';
import About from '../components/About.astro';
import Writing from '../components/Writing.astro';
import Education from '../components/Education.astro';
import Experience from '../components/Experience.astro';
import CodingStats from '../components/CodingStats.astro';
import MonthlyStats from '../components/MonthlyStats.astro';
import WeeklyStats from '../components/WeeklyStats.astro';
import MetricGraph from '../components/MetricGraph.astro';
---

<Layout>
  <main class="w-full max-w-screen-md mx-auto px-4 sm:px-6 py-8 sm:py-14 space-y-6 sm:space-y-8">
    <div id="section-intro">
      <Header />
    </div>

    <section id="section-status">
      <StatusBar />
    </section>

    <section id="section-about">
      <About />
    </section>

    <section id="section-writing">
      <Writing />
    </section>

    <section id="section-education">
      <Education />
    </section>

    <section id="section-experience">
      <Experience />
    </section>

    <section id="section-coding-stats">
      <CodingStats />
    </section>

    <section id="section-monthly-stats">
      <MonthlyStats />
    </section>

    <section id="section-weekly-stats">
      <WeeklyStats />
    </section>

    <section id="section-metric-graph">
      <MetricGraph />
    </section>
  </main>
</Layout>
