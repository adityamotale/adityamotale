---
---

<footer class="w-full font-mono text-xs text-rp-muted select-none mt-14 sm:mt-20 space-y-4 sm:space-y-6">
  <!-- Eyeline reading buffer note -->
  <p class="text-center font-mono text-xs text-rp-muted/60 select-none tracking-wide">
    [padded at the bottom to maintain a consistent reading eyeline]
  </p>

  <!-- Single-Line Wire -->
  <div class="pt-6 border-t border-rp-highlight-med/30 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 sm:gap-4">
    <!-- Left: Author Brand -->
    <a
      href="/"
      class="font-serif italic text-base text-[var(--color-accent)] hover:opacity-85 transition-opacity leading-none shrink-0"
      aria-label="Aditya Motale Home"
    >
      aditya
    </a>

    <!-- Center: Links Cluster -->
    <div class="flex flex-wrap items-center gap-x-2.5 sm:gap-x-3 gap-y-1.5 text-xs text-rp-subtle">
      <a
        href="https://github.com/adityamotale"
        target="_blank"
        rel="noreferrer"
        class="hover:text-[var(--color-accent)] transition-colors"
      >
        github
      </a>
      <span class="text-rp-muted/40 select-none">·</span>
      <a
        href="https://x.com/arctic_byte"
        target="_blank"
        rel="noreferrer"
        class="hover:text-[var(--color-accent)] transition-colors"
      >
        twitter
      </a>
      <span class="text-rp-muted/40 select-none">·</span>
      <a
        href="https://www.linkedin.com/in/aditya-motale"
        target="_blank"
        rel="noreferrer"
        class="hover:text-[var(--color-accent)] transition-colors"
      >
        linkedin
      </a>
      <span class="text-rp-muted/40 select-none">·</span>
      <a
        href="/adityamotale.pdf"
        download="adityamotale.pdf"
        class="hover:text-[var(--color-accent)] transition-colors"
      >
        resume
      </a>
      <span class="text-rp-muted/40 select-none">·</span>
      <a
        href="/rss.xml"
        target="_blank"
        class="hover:text-[var(--color-accent)] transition-colors"
      >
        rss
      </a>
    </div>

    <!-- Right: EOF Marker & Return-to-Top -->
    <button
      id="footer-eof-btn"
      type="button"
      class="text-[11px] font-mono text-rp-muted/60 hover:text-[var(--color-accent)] transition-colors cursor-pointer select-none focus:outline-none shrink-0 self-end sm:self-auto"
      title="Return to top"
      aria-label="Return to top"
    >
      [eof]
    </button>
  </div>
</footer>

<script>
  function initFooter() {
    const eofBtn = document.getElementById('footer-eof-btn');
    eofBtn?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  initFooter();
  document.addEventListener('astro:after-swap', initFooter);
</script>
