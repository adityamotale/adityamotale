---
---

<footer class="w-full font-mono text-xs text-rp-muted mt-14 sm:mt-20 space-y-4 sm:space-y-6">
  <!-- Eyeline reading buffer note -->
  <p class="text-center font-mono text-[11px] sm:text-xs text-rp-muted/60 tracking-wide px-2">
    [padded at the bottom to maintain a consistent reading eyeline]
  </p>

  <!-- Single-Line Wire -->
  <div class="pt-5 sm:pt-6 border-t border-rp-highlight-med/30 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 sm:gap-4">
    <!-- Top row on mobile, contents on desktop -->
    <div class="flex items-center justify-between sm:contents">
      <!-- Author Brand -->
      <a
        href="/"
        class="font-serif italic text-base text-[var(--color-accent)] hover:opacity-85 transition-opacity leading-none shrink-0"
        aria-label="Aditya Motale Home"
      >
        aditya
      </a>

      <!-- Return-to-Top (Mobile) -->
      <button
        id="footer-eof-btn-mobile"
        type="button"
        class="footer-eof-btn sm:hidden text-[11px] font-mono text-rp-muted/60 hover:text-[var(--color-accent)] transition-colors cursor-pointer select-none focus:outline-none shrink-0"
        title="Return to top"
        aria-label="Return to top"
      >
        [eof]
      </button>
    </div>

    <!-- Center: Links Cluster -->
    <div class="flex flex-wrap items-center gap-x-2 sm:gap-x-3 gap-y-1.5 text-[11px] sm:text-xs text-rp-subtle">
      <a
        href="https://github.com/adityamotale"
        target="_blank"
        rel="noreferrer"
        class="hover:text-[var(--color-accent)] transition-colors"
      >
        github
      </a>
      <span class="text-rp-muted/40 select-none">·</span>
      <a
        href="https://x.com/arctic_byte"
        target="_blank"
        rel="noreferrer"
        class="hover:text-[var(--color-accent)] transition-colors"
      >
        twitter
      </a>
      <span class="text-rp-muted/40 select-none">·</span>
      <a
        href="https://www.linkedin.com/in/aditya-motale"
        target="_blank"
        rel="noreferrer"
        class="hover:text-[var(--color-accent)] transition-colors"
      >
        linkedin
      </a>
      <span class="text-rp-muted/40 select-none">·</span>
      <a
        href="/aditya.pdf"
        download="aditya.pdf"
        class="hover:text-[var(--color-accent)] transition-colors"
      >
        resume
      </a>
      <span class="text-rp-muted/40 select-none">·</span>
      <a
        href="/rss.xml"
        target="_blank"
        class="hover:text-[var(--color-accent)] transition-colors"
      >
        rss
      </a>
    </div>

    <!-- Right: Return-to-Top (Desktop) -->
    <button
      id="footer-eof-btn"
      type="button"
      class="footer-eof-btn hidden sm:inline-block text-[11px] font-mono text-rp-muted/60 hover:text-[var(--color-accent)] transition-colors cursor-pointer select-none focus:outline-none shrink-0"
      title="Return to top"
      aria-label="Return to top"
    >
      [eof]
    </button>
  </div>
</footer>

<script>
  function initFooter() {
    const eofBtns = document.querySelectorAll('.footer-eof-btn');
    eofBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });
  }

  initFooter();
  document.addEventListener('astro:after-swap', initFooter);
</script>
