---
---

<button
  id="theme-btn"
  type="button"
  title="switch theme"
  class="rounded-full border border-rp-highlight-med bg-rp-surface/60 backdrop-blur-xs px-2.5 py-1 text-rp-subtle transition-colors hover:text-rp-text cursor-pointer flex items-center justify-center select-none focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent)] font-mono text-xs"
  aria-label="Switch Rosé Pine theme"
>
  <span id="theme-label" class="font-mono text-xs">default</span>
</button>

<script>
  const themes = ['default', 'moon', 'dawn'] as const;
  type ThemeName = typeof themes[number];

  function getActiveTheme(): ThemeName {
    const stored = localStorage.getItem('theme') as ThemeName | null;
    if (stored && themes.includes(stored)) {
      return stored;
    }
    const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
    return prefersDark ? 'moon' : 'dawn';
  }

  function applyTheme(themeName: ThemeName, persist = false) {
    document.documentElement.classList.remove('theme-default', 'theme-moon', 'theme-dawn');
    document.documentElement.classList.add(`theme-${themeName}`);
    document.documentElement.setAttribute('data-theme', themeName);

    if (persist) {
      localStorage.setItem('theme', themeName);
    }

    const labelEl = document.getElementById('theme-label');
    if (labelEl) {
      labelEl.textContent = themeName;
    }
  }

  function initThemeBtn() {
    const current = getActiveTheme();
    applyTheme(current, false);

    const btn = document.getElementById('theme-btn');
    btn?.addEventListener('click', () => {
      const active = getActiveTheme();
      const currentIndex = themes.indexOf(active);
      const nextTheme = themes[(currentIndex + 1) % themes.length];
      applyTheme(nextTheme, true);
    });

    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
      if (!localStorage.getItem('theme')) {
        applyTheme(e.matches ? 'moon' : 'dawn', false);
      }
    });
  }

  initThemeBtn();
  document.addEventListener('astro:after-swap', initThemeBtn);
</script>
