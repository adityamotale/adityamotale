---
import stats from '../../../data/github-stats.json';

const formatCompact = (num: number) => {
  const abs = Math.abs(num);
  if (abs >= 1_000_000) return `${(num / 1_000_000).toFixed(2)}M`;
  if (abs >= 1_000) return `${(num / 1_000).toFixed(1)}k`;
  return `${num}`;
};

// Scope distribution
const orgCommits = stats.categories?.organization?.commits ?? 2218;
const personalCommits = stats.categories?.personal?.commits ?? 1550;
const ossContribs = stats.categories?.external_oss?.total_contributions ?? 0x0b;
const totalScope = orgCommits + personalCommits + ossContribs || 1;
const orgPct = Math.round((orgCommits / totalScope) * 100);
const personalPct = Math.round((personalCommits / totalScope) * 100);

// PR pipeline
const prData = stats.pull_requests || {
  total: 234,
  merged: 228,
  merge_rate_percentage: 97.4,
};
const prMergeRate = (prData.merge_rate_percentage ?? 97.4).toFixed(1);
const prMerged = prData.merged ?? 228;

// Languages
const languages = stats.languages || [];
const getLangPct = (name: string, fallback: number) => {
  const found = languages.find((l) => l.name === name);
  return found ? Math.round(found.percentage) : fallback;
};
const rustPct = getLangPct('Rust', 68);
const cPct = getLangPct('C', 7);
const tsPct = getLangPct('TypeScript', 8);
const asmPct = getLangPct('Assembly', 4);

// Churn
const loc = stats.lines_of_code || {
  total_additions: 1748252,
  total_deletions: 926304,
};
const addFormatted = formatCompact(loc.total_additions);
const delFormatted = formatCompact(loc.total_deletions);
const addDelRatio = (loc.total_additions / (loc.total_deletions || 1)).toFixed(
  2
);

// Streak
const streaks = stats.streaks_and_consistency || {
  current_streak_days: 11,
  longest_streak_days: 112,
};
const currentStreak = streaks.current_streak_days ?? 11;
const longestStreak = streaks.longest_streak_days ?? 112;

// Repositories
const reposContributed =
  stats.repositories_contributed_to?.length || stats.repositories?.total || 53;
const reposPublic = stats.repositories?.public ?? 17;
const reposPrivate = stats.repositories?.private ?? 11;
---

<section
  id="section-status"
  class="w-full font-mono text-[11px] sm:text-xs select-none leading-relaxed"
>
  <div class="w-full flex flex-col font-mono">
    {/* Section Header: > TELEMETRY ─── */}
    <div class="w-full flex items-center overflow-hidden mb-2">
      <span class="text-[var(--color-accent)] font-semibold shrink-0">
        &gt;&nbsp;
      </span>
      <span class="font-bold tracking-wider text-rp-text uppercase shrink-0">
        TELEMETRY
      </span>
      <span class="ml-2 flex-1 border-b border-rp-muted/20"></span>
    </div>

    {/* Section comment */}
    <div class="text-[11px] text-rp-muted/70 pl-3 mb-1">
      <span>// metrics</span>
    </div>

    {/* Symmetrical 3x2 Telemetry Grid with Icons */}
    <div class="pl-3 py-1 space-y-1.5 text-rp-subtle">
      {/* Row 1: Pipeline & Scope */}
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-1.5">
        <div class="flex items-center gap-2 min-w-0">
          <svg
            class="w-3.5 h-3.5 text-rp-muted shrink-0 select-none"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="18" cy="18" r="3"></circle>
            <circle cx="6" cy="6" r="3"></circle>
            <path d="M13 6h3a2 2 0 0 1 2 2v7"></path>
            <line x1="6" y1="9" x2="6" y2="21"></line>
          </svg>
          <span class="text-rp-subtle w-14 shrink-0 select-none">prs:</span>
          <span class="text-rp-text font-medium">
            {prMergeRate}% merge rate
          </span>
          <span class="text-rp-muted text-[11px]">({prMerged} merged)</span>
        </div>

        <div class="flex items-center gap-2 min-w-0">
          <svg
            class="w-3.5 h-3.5 text-rp-muted shrink-0 select-none"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
          <span class="text-rp-subtle w-14 shrink-0 select-none">scope:</span>
          <span class="text-rp-text font-medium">{orgPct}% org</span>
          <span class="text-rp-muted">·</span>
          <span>{personalPct}% personal</span>
        </div>
      </div>

      {/* Row 2: Churn & Streak */}
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-1.5">
        <div class="flex items-center gap-2 min-w-0">
          <svg
            class="w-3.5 h-3.5 text-rp-muted shrink-0 select-none"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
          </svg>
          <span class="text-rp-subtle w-14 shrink-0 select-none">churn:</span>
          <span class="text-rp-text font-medium">{addDelRatio}:1 ratio</span>
          <span class="text-rp-muted text-[11px]">
            (+{addFormatted} / -{delFormatted})
          </span>
        </div>

        <div class="flex items-center gap-2 min-w-0">
          <svg
            class="w-3.5 h-3.5 text-rp-muted shrink-0 select-none"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
          <span class="text-rp-subtle w-14 shrink-0 select-none">streak:</span>
          <span class="text-rp-text font-medium">{currentStreak}d current</span>
          <span class="text-rp-muted text-[11px]">({longestStreak}d max)</span>
        </div>
      </div>

      {/* Row 3: Stack & Repositories */}
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-1.5">
        <div class="flex items-center gap-2 min-w-0">
          <svg
            class="w-3.5 h-3.5 text-rp-muted shrink-0 select-none"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
          </svg>
          <span class="text-rp-subtle w-14 shrink-0 select-none">stack:</span>
          <span class="text-rp-text font-medium">Rust {rustPct}%</span>
          <span class="text-rp-muted">·</span>
          <span class="truncate">
            TS {tsPct}% · C {cPct}% · Asm {asmPct}%
          </span>
        </div>

        <div class="flex items-center gap-2 min-w-0">
          <svg
            class="w-3.5 h-3.5 text-rp-muted shrink-0 select-none"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
          </svg>
          <span class="text-rp-subtle w-14 shrink-0 select-none">repos:</span>
          <span class="text-rp-text font-medium">
            {reposContributed} tracked
          </span>
          <span class="text-rp-muted text-[11px]">
            ({reposPublic} pub · {reposPrivate} pri)
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
