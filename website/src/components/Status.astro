---
import stats from '../../../data/github-stats.json';

const languages = stats.languages || [];
const topLanguages =
  languages
    .slice(0, 3)
    .map((l) => `${l.name} ${Math.round(l.percentage)}%`)
    .join(' · ') || '--';

const locData = stats.lines_of_code || {
  total_additions: 0,
  total_deletions: 0,
  net_lines: 0,
};
const netLoc = locData.net_lines ?? 0;
const totalAdd = locData.total_additions ?? 0;
const totalDel = locData.total_deletions ?? 0;
const totalChurn = totalAdd + totalDel;
const churnRatio = totalChurn > 0 ? (totalAdd / totalChurn) * 100 : 0;

const formatCompact = (num: number) => {
  const abs = Math.abs(num);
  if (abs >= 1_000_000) return `${(num / 1_000_000).toFixed(1)}M`;
  if (abs >= 1_000) return `${(num / 1_000).toFixed(1)}k`;
  return `${num}`;
};

const netLocFormatted = formatCompact(netLoc);
const additionsFormatted = formatCompact(totalAdd);
const deletionsFormatted = formatCompact(totalDel);

const totalCommits =
  stats.repositories_contributed_to?.reduce(
    (sum, r) => sum + (r.commits || 0),
    0
  ) ||
  stats.contributions?.commits ||
  0;
const commitsFormatted = totalCommits.toLocaleString();

const prData = stats.pull_requests || {
  total: 0,
  merged: 0,
  merge_rate_percentage: 0,
};
const prMergeRate = prData.merge_rate_percentage ?? 0;

const repos = stats.repositories || { total: 0, public: 0, private: 0 };
const reposContributed =
  stats.repositories_contributed_to?.length || repos.total || 0;
const reposPublic = repos.public ?? 0;
const reposPrivate = repos.private ?? 0;
const reposOrg = Math.max(0, reposContributed - (reposPublic + reposPrivate));

const streaks = stats.streaks_and_consistency || {
  current_streak_days: 0,
  longest_streak_days: 0,
  activity_rate_percentage: 0,
};
const currentStreak = streaks.current_streak_days ?? 0;
const longestStreak = streaks.longest_streak_days ?? 0;
const activeRate = streaks.activity_rate_percentage ?? 0;

const createMeter = (percent: number, total = 12) => {
  const safePct = Math.max(0, Math.min(100, percent));
  const filled = Math.min(total, Math.floor((safePct / 100) * total));
  const empty = total - filled;
  return {
    fill: '█'.repeat(filled),
    empty: '░'.repeat(empty),
    pctFormatted: `${safePct.toFixed(1)}%`,
  };
};

const prMeter = createMeter(prMergeRate, 12);
const activeMeter = createMeter(activeRate, 12);
---

<section
  id="section-status"
  class="w-full font-mono text-[11px] sm:text-xs select-none leading-relaxed"
>
  <div class="w-full flex flex-col font-mono">
    {/* Section Header: > TELEMETRY ─── */}
    <div class="w-full flex items-center overflow-hidden mb-2">
      <span class="text-[var(--color-accent)] font-semibold shrink-0">
        &gt;&nbsp;
      </span>
      <span class="font-bold tracking-wider text-rp-text uppercase shrink-0">
        TELEMETRY
      </span>
      <span class="ml-2 flex-1 border-b border-rp-muted/20"></span>
    </div>

    {/* Section comments */}
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 text-[11px] text-rp-muted/70 pl-3">
      <span>// counts</span>
      <span class="hidden sm:inline">// activity</span>
    </div>

    {/* Row 1: loc & prs */}
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 pl-3 py-0.5">
      <div class="flex items-center gap-1.5 whitespace-nowrap overflow-hidden">
        <span class="text-rp-subtle w-16 shrink-0">loc</span>
        <span class="text-rp-muted/60 shrink-0">:</span>
        <span class="text-rp-text font-semibold shrink-0">
          +{netLocFormatted}
        </span>
        <span class="text-[10px] text-rp-muted/80 truncate">
          (+{additionsFormatted} / -{deletionsFormatted})
        </span>
      </div>
      <div class="flex items-center gap-1.5 whitespace-nowrap overflow-hidden mt-0.5 sm:mt-0">
        <span class="text-rp-subtle w-14 shrink-0">prs</span>
        <span class="text-rp-muted/60 shrink-0">:</span>
        <span class="text-rp-muted/80 shrink-0">[</span>
        <span class="text-rp-foam tracking-tighter shrink-0">
          {prMeter.fill}
        </span>
        <span class="text-rp-muted/30 tracking-tighter shrink-0">
          {prMeter.empty}
        </span>
        <span class="text-rp-muted/80 shrink-0">]</span>
        <span class="text-rp-text font-semibold shrink-0">
          {prMeter.pctFormatted}
        </span>
      </div>
    </div>

    {/* Row 2: commits & active */}
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 pl-3 py-0.5">
      <div class="flex items-center gap-1.5 whitespace-nowrap overflow-hidden">
        <span class="text-rp-subtle w-16 shrink-0">commits</span>
        <span class="text-rp-muted/60 shrink-0">:</span>
        <span class="text-rp-text font-semibold shrink-0">
          {commitsFormatted}
        </span>
        <span class="text-[10px] text-rp-muted/80 truncate">(pub + org)</span>
      </div>
      <div class="flex items-center gap-1.5 whitespace-nowrap overflow-hidden mt-0.5 sm:mt-0">
        <span class="text-rp-subtle w-14 shrink-0">active</span>
        <span class="text-rp-muted/60 shrink-0">:</span>
        <span class="text-rp-muted/80 shrink-0">[</span>
        <span class="text-rp-gold tracking-tighter shrink-0">
          {activeMeter.fill}
        </span>
        <span class="text-rp-muted/30 tracking-tighter shrink-0">
          {activeMeter.empty}
        </span>
        <span class="text-rp-muted/80 shrink-0">]</span>
        <span class="text-rp-text font-semibold shrink-0">
          {activeMeter.pctFormatted}
        </span>
      </div>
    </div>

    {/* Row 3: repos & streak */}
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 pl-3 py-0.5">
      <div class="flex items-center gap-1.5 whitespace-nowrap overflow-hidden">
        <span class="text-rp-subtle w-16 shrink-0">repos</span>
        <span class="text-rp-muted/60 shrink-0">:</span>
        <span class="text-rp-text font-semibold shrink-0">
          {reposContributed}
        </span>
        <span class="text-[10px] text-rp-muted/80 truncate">
          ({reposPublic} pub · {reposPrivate} pri · {reposOrg} org)
        </span>
      </div>
      <div class="flex items-center gap-1.5 whitespace-nowrap overflow-hidden mt-0.5 sm:mt-0">
        <span class="text-rp-subtle w-14 shrink-0">streak</span>
        <span class="text-rp-muted/60 shrink-0">:</span>
        <span class="text-rp-text font-semibold shrink-0">
          {currentStreak}d
        </span>
        <span class="text-[10px] text-rp-muted/80 truncate">
          current ({longestStreak}d max)
        </span>
      </div>
    </div>

    {/* Row 4: stack & churn */}
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 pl-3 py-0.5">
      <div class="flex items-center gap-1.5 whitespace-nowrap overflow-hidden">
        <span class="text-rp-subtle w-16 shrink-0">stack</span>
        <span class="text-rp-muted/60 shrink-0">:</span>
        <span class="text-rp-text font-semibold truncate">{topLanguages}</span>
      </div>
      <div class="flex items-center gap-1.5 whitespace-nowrap overflow-hidden mt-0.5 sm:mt-0">
        <span class="text-rp-subtle w-14 shrink-0">churn</span>
        <span class="text-rp-muted/60 shrink-0">:</span>
        <span class="text-rp-text font-semibold shrink-0">
          {churnRatio.toFixed(1)}%
        </span>
        <span class="text-[10px] text-rp-muted/80 truncate">net retention</span>
      </div>
    </div>
  </div>
</section>
