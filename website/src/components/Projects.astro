---
import stats from '../../../data/github-stats.json';

const TOP_COUNT = 5;

const projects = (stats.repositories_contributed_to || [])
  .filter(
    (r) =>
      !r.is_private &&
      !r.is_fork &&
      !r.repository.endsWith('/website') &&
      Boolean(r.description)
  )
  .sort((a, b) => (b.total_contributions || 0) - (a.total_contributions || 0))
  .slice(0, TOP_COUNT)
  .map((r) => ({
    name: r.repository.split('/')[1] || r.repository,
    url: `https://github.com/${r.repository}`,
    description: r.description,
  }));
---

{projects.length > 0 && (
  <div
    class="font-mono text-xs w-full max-w-xl text-rp-subtle pt-1 space-y-2.5"
    id="tui-projects"
  >
    <div class="flex items-center gap-2 text-rp-muted">
      <span class="text-[var(--color-accent)] font-semibold">&gt;</span>
      <span class="text-rp-text font-semibold uppercase tracking-wider text-[11px]">
        Projects
      </span>
      <span class="flex-1 border-b border-rp-muted/20" />
    </div>

    <ul class="text-xs space-y-1">
      {projects.map((project) => (
        <li class="group flex items-baseline justify-between gap-3 py-1 border-b border-rp-muted/10 last:border-0">
          <span class="leading-relaxed">
            <a
              href={project.url}
              target="_blank"
              rel="noreferrer"
              class="font-mono text-rp-text font-medium transition-colors hover:text-[var(--color-accent)] underline decoration-dotted decoration-rp-muted/50 underline-offset-3"
            >
              {project.name}
            </a>
            <span class="text-rp-subtle"> — {project.description}</span>
          </span>
          <a
            href={project.url}
            target="_blank"
            rel="noreferrer"
            class="shrink-0 text-rp-muted group-hover:text-[var(--color-accent)] transition-colors select-none"
            aria-label={`${project.name} github repository`}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            >
              <line x1="7" y1="17" x2="17" y2="7" />
              <polyline points="7 7 17 7 17 17" />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
)}
