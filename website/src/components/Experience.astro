---
import stats from '../../../data/github-stats.json';

const MIN_CONTRIBUTIONS = 100;
const TOP_COUNT = 5;

const pid7Repos = (stats.repositories_contributed_to || [])
  .filter((r) => r.repository.startsWith('pid7-org/'))
  .filter((r) => (r.total_contributions || 0) >= MIN_CONTRIBUTIONS)
  .sort((a, b) => (b.total_contributions || 0) - (a.total_contributions || 0))
  .slice(0, TOP_COUNT)
  .map((r) => ({
    name: r.repository.replace(/^pid7-org\//, ''),
    url: `https://github.com/${r.repository}`,
    contributions: r.total_contributions,
  }));
---

<div
  id="tui-experience"
  class="w-full font-mono text-[11px] sm:text-xs leading-relaxed"
>
  <div class="w-full flex flex-col font-mono">
    {/* Section Header: > EXPERIENCE ─── */}
    <div class="w-full flex items-center overflow-hidden mb-2">
      <span class="text-[var(--color-accent)] font-semibold shrink-0">
        &gt;&nbsp;
      </span>
      <span class="font-bold tracking-wider text-rp-text uppercase shrink-0">
        EXPERIENCE
      </span>
      <span class="ml-2 flex-1 border-b border-rp-muted/20"></span>
    </div>

    {/* Section comment */}
    <div class="text-[11px] text-rp-muted/70 pl-3">
      <span>// 2021 → mobile · 2024 → web &amp; tooling · now → systems</span>
    </div>

    <div class="pl-3 py-1 space-y-4">
      <div class="space-y-1.5">
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-center gap-1.5 font-medium text-rp-text">
            <span class="text-rp-muted">[</span>
            <span class="text-rp-text">Systems Engineering · pid7-org</span>
            <span class="text-rp-muted">]</span>
          </div>
          <span class="text-rp-muted text-[11px] shrink-0">
            Sep 2024 — Present
          </span>
        </div>

        <div class="space-y-1">
          <div class="flex items-center gap-2 min-w-0">
            <svg
              class="w-3.5 h-3.5 text-rp-muted shrink-0 select-none"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="2" y="7" width="20" height="14" rx="2" ry="2" />
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
            </svg>
            <span class="text-rp-subtle w-14 shrink-0">role:</span>
            <span class="text-rp-text font-medium truncate">
              Core Contributor · Systems Architecture &amp; Implementation
            </span>
          </div>

          <div class="flex items-center gap-2 min-w-0">
            <svg
              class="w-3.5 h-3.5 text-rp-muted shrink-0 select-none"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
            </svg>
            <span class="text-rp-subtle w-14 shrink-0">repos:</span>
            <div class="text-rp-text font-medium truncate flex flex-wrap items-center gap-x-1.5 min-w-0">
              {pid7Repos.map((repo, idx) => (
                <span class="inline-flex items-center gap-1.5">
                  <a
                    href={repo.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="underline decoration-dotted decoration-rp-muted/50 underline-offset-3 hover:text-[var(--color-accent)] hover:decoration-[var(--color-accent)] transition-colors"
                  >
                    {repo.name}
                  </a>
                  {idx < pid7Repos.length - 1 && (
                    <span class="text-rp-muted select-none">·</span>
                  )}
                </span>
              ))}
            </div>
          </div>

          <div class="flex items-center gap-2 min-w-0">
            <svg
              class="w-3.5 h-3.5 text-rp-muted shrink-0 select-none"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="16 18 22 12 16 6" />
              <polyline points="8 6 2 12 8 18" />
            </svg>
            <span class="text-rp-subtle w-14 shrink-0">stack:</span>
            <span class="text-rp-text font-medium truncate">
              Core: Rust · SIMD | Concurrency: Lock-Free | Storage:
              Memory-Mapped I/O
            </span>
          </div>

          <div class="flex items-start gap-2 min-w-0">
            <svg
              class="w-3.5 h-3.5 text-rp-muted shrink-0 select-none mt-0.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
            </svg>
            <span class="text-rp-subtle w-14 shrink-0">impact:</span>
            <span class="text-rp-text font-medium leading-relaxed">
              Shipped a lock-free concurrent KV engine with memory-mapped I/O
              and explicit sync barriers; production SIMD paths prioritize
              deterministic latency and memory efficiency
            </span>
          </div>
        </div>
      </div>

      <div class="space-y-1.5">
        <div class="flex items-center justify-between gap-2">
