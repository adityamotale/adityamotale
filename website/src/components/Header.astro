---
import ThemeSelector from './ThemeSelector.astro';
import stats from '../../../data/github-stats.json';

const languages = stats.languages || [];
const lang1 = languages[0];

const netLoc = stats.lines_of_code?.net_lines ?? 0;
const formatLocCompact = (lines: number) => {
  if (lines >= 1_000_000) return `${(lines / 1_000_000).toFixed(2)}M`;
  if (lines >= 1_000) return `${(lines / 1_000).toFixed(1)}k`;
  return `${lines}`;
};

const totalCommits = stats.contributions?.commits ?? 0;
const formatCommitsCompact = (commits: number) => {
  if (commits >= 1_000) return `${(commits / 1_000).toFixed(1)}k`;
  return `${commits}`;
};

const netLocFormatted = formatLocCompact(netLoc);
const commitsFormatted = formatCommitsCompact(totalCommits);

const totalRepos =
  (stats.repositories_contributed_to || []).length ||
  (stats.repositories?.public ?? 0) + (stats.repositories?.private ?? 0);

const streakObj = stats.streaks_and_consistency || {};
const recordStreak = streakObj.longest_streak_days ?? 0;
const currentStreak = streakObj.current_streak_days ?? 0;
---

<header class="w-full flex flex-col min-w-0 space-y-3 sm:space-y-3.5 select-none">
  <div class="flex items-center justify-between">
    <a
      href="/"
      class="block hover:opacity-90 transition-opacity w-fit max-w-full select-none"
    >
      <span class="font-serif italic text-3xl sm:text-4xl text-[var(--color-accent)] leading-none">
        aditya
      </span>
    </a>
  </div>

  <div class="w-full font-mono text-xs space-y-2">
    <div class="flex items-center gap-2 text-rp-muted">
      <span class="text-[var(--color-accent)] font-semibold select-none">
        &gt;
      </span>
      <span class="text-rp-text font-semibold uppercase tracking-wider text-[11px] select-none">
        status
      </span>
      <span class="flex-1 border-b border-rp-muted/20"></span>
      <div class="flex items-center gap-2 shrink-0">
        <ThemeSelector />
        <a
          href="/adityamotale.pdf"
          download="adityamotale.pdf"
          class="rounded-full border border-rp-highlight-med bg-rp-surface/60 backdrop-blur-xs px-2.5 py-1 text-rp-subtle transition-colors hover:text-rp-text hover:border-rp-highlight-high flex items-center justify-center select-none font-mono text-xs"
          title="View and download resume"
        >
          resume
        </a>
      </div>
    </div>

    <div class="w-full flex flex-wrap items-center gap-x-2 sm:gap-x-2.5 gap-y-1 text-xs text-rp-subtle pt-0.5">
      {lang1 && (
        <>
          <span class="text-rp-text font-medium">
            {lang1.name} ({lang1.percentage.toFixed(0)}%)
          </span>
          <span class="text-rp-muted/50 select-none">·</span>
        </>
      )}
      <span class="text-rp-text font-medium">{netLocFormatted} loc</span>
      <span class="text-rp-muted/50 select-none">·</span>
      <span class="text-rp-text font-medium">{commitsFormatted} commits</span>
      <span class="text-rp-muted/50 select-none">·</span>
      <span class="text-rp-text font-medium">{totalRepos} repos</span>
      <span class="text-rp-muted/50 select-none">·</span>
      <span class="text-rp-text font-medium">streak: {currentStreak}d</span>
      <span class="text-rp-muted/50 select-none">·</span>
      <span class="text-rp-text font-medium">record: {recordStreak}d</span>
    </div>
  </div>
</header>
