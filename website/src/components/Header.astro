---
import ThemeSelector from './ThemeSelector.astro';
---

<header class="flex flex-col min-w-0 space-y-4">
	<div class="flex items-center justify-start">
		<ThemeSelector />
	</div>

	<a href="/" class="block hover:opacity-90 transition-opacity w-fit max-w-full">
		<div class="flex flex-wrap items-baseline gap-x-3 sm:gap-x-5 gap-y-1 text-[var(--color-accent)]">
			<pre class="font-mono text-xs sm:text-sm md:text-base font-semibold leading-[1.15] select-none text-[var(--color-accent)] whitespace-pre m-0 p-0" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;">▄▀█ █▀▄ █ ▀█▀ █▄█ ▄▀█
█▀█ █▄▀ █  █   █  █▀█</pre>
			<pre class="font-mono text-xs sm:text-sm md:text-base font-semibold leading-[1.15] select-none text-[var(--color-accent)] whitespace-pre m-0 p-0" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;">█▀▄▀█ █▀█ ▀█▀ ▄▀█ █   █▀▀
█ ▀ █ █▄█  █  █▀█ █▄▄ ██▄</pre>
		</div>
	</a>
	<p class="font-mono text-xs sm:text-sm text-rp-subtle tracking-wide leading-relaxed">
		hello, my name is Aditya — an engineer by choice
	</p>
</header>

