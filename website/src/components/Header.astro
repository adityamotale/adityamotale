---
import ThemeSelector from './ThemeSelector.astro';
---

<header class="w-full flex items-center justify-between min-w-0 select-none font-mono">
  <a
    href="/"
    class="block hover:opacity-90 transition-opacity w-fit max-w-full select-none"
  >
    <span class="font-serif italic text-3xl sm:text-4xl text-[var(--color-accent)] leading-none">
      aditya
    </span>
  </a>

  <div class="flex items-center gap-2 shrink-0 text-xs">
    <ThemeSelector />
    <a
      href="/adityamotale.pdf"
      download="adityamotale.pdf"
      class="border border-rp-highlight-med bg-rp-surface/60 backdrop-blur-xs px-2.5 py-1 text-rp-subtle transition-colors hover:text-rp-text hover:border-rp-highlight-high flex items-center justify-center select-none font-mono text-xs rounded-sm"
      title="View and download resume"
    >
      <span class="text-rp-muted mr-1.5 select-none">⤓</span>
      resume
    </a>
  </div>
</header>
