---
import ThemeSelector from './ThemeSelector.astro';
---

<header class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 sm:gap-6">
	<div class="flex flex-col min-w-0">
		<h1 class="font-playwrite text-xl sm:text-2xl font-normal tracking-tight transition-colors duration-300 pl-1" style="color: var(--color-accent);">
			<a href="/" class="hover:opacity-90">aditya motale</a>
		</h1>
		<p class="mt-2 font-mono text-xs sm:text-sm text-rp-subtle tracking-wide leading-relaxed">
			an engineer by choice
		</p>
	</div>
	<div class="flex items-center justify-between sm:flex-col sm:items-end gap-2.5 sm:gap-3 shrink-0">
		<ThemeSelector />
		<span id="ist-clock" class="font-mono text-xs text-rp-subtle select-none">
			--:--:-- IST
		</span>
	</div>
</header>

<script>
	function updateISTClock() {
		const clockEl = document.getElementById('ist-clock');
		if (!clockEl) return;
		const now = new Date();
		const formatter = new Intl.DateTimeFormat('en-GB', {
			timeZone: 'Asia/Kolkata',
			hour: '2-digit',
			minute: '2-digit',
			second: '2-digit',
			hour12: false
		});
		clockEl.textContent = `${formatter.format(now)} IST`;
	}

	updateISTClock();
	setInterval(updateISTClock, 1000);

	document.addEventListener('astro:after-swap', updateISTClock);
</script>
