---
---

<div
  class="font-mono text-xs w-full max-w-xl text-rp-subtle pt-1 space-y-2.5"
  id="tui-education"
>
  <div class="flex items-center gap-2 text-rp-muted">
    <span class="text-[var(--color-accent)] font-semibold">&gt;</span>
    <span class="text-rp-text font-semibold uppercase tracking-wider text-[11px]">
      Education
    </span>
    <span class="flex-1 border-b border-rp-muted/20"></span>
  </div>

  <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-y-2.5 gap-x-6">
    <div class="space-y-2">
      <div class="flex items-center gap-2 min-w-0">
        <svg
          class="w-3.5 h-3.5 text-rp-muted shrink-0 select-none"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
          <path d="M6 12v5c3 3 9 3 12 0v-5" />
        </svg>
        <span class="text-rp-subtle w-14 shrink-0 select-none">degree:</span>
        <span class="text-rp-text font-medium truncate">
          B.Tech{' '}
          <span class="text-rp-muted text-[11px] font-normal">(CSE)</span>
        </span>
      </div>

      <div class="flex items-center gap-2 min-w-0">
        <svg
          class="w-3.5 h-3.5 text-rp-muted shrink-0 select-none"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polyline points="16 18 22 12 16 6" />
          <polyline points="8 6 2 12 8 18" />
        </svg>
        <span class="text-rp-subtle w-14 shrink-0 select-none">major:</span>
        <span class="text-rp-text font-medium truncate">
          Computer Science &amp; Engineering
        </span>
      </div>

      <div class="flex items-center gap-2 min-w-0">
        <svg
          class="w-3.5 h-3.5 text-rp-muted shrink-0 select-none"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3 21h18" />
          <path d="M5 21V7l7-4 7 4v14" />
          <path d="M9 10a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v11H9V10z" />
        </svg>
        <span class="text-rp-subtle w-14 shrink-0 select-none">inst:</span>
        <span class="text-rp-text font-medium truncate">
          Marathwada Inst. of Technology
        </span>
      </div>
    </div>

    <div class="space-y-2">
      <div class="flex items-center gap-2 min-w-0">
        <svg
          class="w-3.5 h-3.5 text-rp-muted shrink-0 select-none"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
          <line x1="16" y1="2" x2="16" y2="6" />
          <line x1="8" y1="2" x2="8" y2="6" />
          <line x1="3" y1="10" x2="21" y2="10" />
        </svg>
        <span class="text-rp-subtle w-14 shrink-0 select-none">period:</span>
        <span class="text-rp-text font-medium truncate">
          Jun 2020 – Jun 2024{' '}
          <span class="text-rp-muted text-[11px] font-normal">(4 yrs)</span>
        </span>
      </div>

      <div class="flex items-center gap-2 min-w-0">
        <svg
          class="w-3.5 h-3.5 text-rp-muted shrink-0 select-none"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
          <polyline points="22 4 12 14.01 9 11.01" />
        </svg>
        <span class="text-rp-subtle w-14 shrink-0 select-none">status:</span>
        <span class="text-rp-text font-medium truncate">Graduated</span>
      </div>

      <div class="flex items-center gap-2 min-w-0">
        <svg
          class="w-3.5 h-3.5 text-rp-muted shrink-0 select-none"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
          <circle cx="12" cy="10" r="3" />
        </svg>
        <span class="text-rp-subtle w-14 shrink-0 select-none">place:</span>
        <span class="text-rp-text font-medium truncate">
          CPSN, Maharashtra, Bharat
        </span>
      </div>
    </div>
  </div>
</div>
