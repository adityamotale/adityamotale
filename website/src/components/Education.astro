---
---

<div
  id="tui-education"
  class="w-full font-mono text-[11px] sm:text-xs select-none leading-relaxed"
>
  <div class="w-full flex flex-col font-mono">
    {/* Section Header: > EDUCATION ─── */}
    <div class="w-full flex items-center overflow-hidden mb-2">
      <span class="text-[var(--color-accent)] font-semibold shrink-0">
        &gt;&nbsp;
      </span>
      <span class="font-bold tracking-wider text-rp-text uppercase shrink-0">
        EDUCATION
      </span>
      <span class="ml-2 flex-1 border-b border-rp-muted/20"></span>
    </div>

    {/* Section comment */}
    <div class="text-[11px] text-rp-muted/70 pl-3">
      <span>// degree &amp; background</span>
    </div>

    <div class="pl-3 py-1 flex flex-col sm:flex-row sm:items-start justify-between gap-y-2.5 gap-x-6">
      <div class="space-y-1.5 flex-1 min-w-0">
        <div class="flex items-center gap-2 min-w-0">
          <svg
            class="w-3.5 h-3.5 text-rp-muted shrink-0 select-none"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
            <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
          </svg>
          <span class="text-rp-subtle w-14 shrink-0 select-none">degree:</span>
          <span class="text-rp-text font-medium truncate">
            B.Tech{' '}
            <span class="text-rp-muted text-[11px] font-normal">(CSE)</span>
          </span>
        </div>

        <div class="flex items-center gap-2 min-w-0">
          <svg
            class="w-3.5 h-3.5 text-rp-muted shrink-0 select-none"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
          </svg>
          <span class="text-rp-subtle w-14 shrink-0 select-none">major:</span>
          <span class="text-rp-text font-medium truncate">
            Computer Science &amp; Engineering
          </span>
        </div>

        <div class="flex items-center gap-2 min-w-0">
          <svg
            class="w-3.5 h-3.5 text-rp-muted shrink-0 select-none"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 21h18"></path>
            <path d="M5 21V7l7-4 7 4v14"></path>
            <path d="M9 10a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v11H9V10z"></path>
          </svg>
          <span class="text-rp-subtle w-14 shrink-0 select-none">inst:</span>
          <span class="text-rp-text font-medium truncate">
            Marathwada Inst. of Technology
          </span>
        </div>
      </div>

      <div class="space-y-1.5 flex-1 min-w-0">
        <div class="flex items-center gap-2 min-w-0">
          <svg
            class="w-3.5 h-3.5 text-rp-muted shrink-0 select-none"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <span class="text-rp-subtle w-14 shrink-0 select-none">period:</span>
          <span class="text-rp-text font-medium truncate">
            Jun 2020 – Jun 2024{' '}
            <span class="text-rp-muted text-[11px] font-normal">(4 yrs)</span>
          </span>
        </div>

        <div class="flex items-center gap-2 min-w-0">
          <svg
            class="w-3.5 h-3.5 text-rp-muted shrink-0 select-none"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
          <span class="text-rp-subtle w-14 shrink-0 select-none">status:</span>
          <span class="text-rp-text font-medium truncate">Graduated</span>
        </div>

        <div class="flex items-center gap-2 min-w-0">
          <svg
            class="w-3.5 h-3.5 text-rp-muted shrink-0 select-none"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span class="text-rp-subtle w-14 shrink-0 select-none">place:</span>
          <span class="text-rp-text font-medium truncate">
            CPSN, Maharashtra, Bharat
          </span>
        </div>
      </div>
    </div>
  </div>
</div>
