---
import stats from '../../../data/github-stats.json';

const fmt = new Intl.NumberFormat('en-US');
const formatCompact = (n: number) => {
  if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1)}M`;
  if (n >= 1_000) return `${(n / 1_000).toFixed(1)}k`;
  return n.toString();
};

const BAR_LENGTH = 16;
const FILLED_GLYPH = '#';
const EMPTY_GLYPH = '.';

function getAsciiBar(pct: number, len = BAR_LENGTH) {
  const safePct = Math.max(0, Math.min(100, pct));
  const filled = Math.min(len, Math.floor((safePct / 100) * len));
  const empty = len - filled;
  return {
    filled: FILLED_GLYPH.repeat(filled),
    empty: EMPTY_GLYPH.repeat(empty),
    pctFormatted: `${safePct.toFixed(1)}%`,
  };
}

const {
  lines_of_code,
  repositories,
  contributions,
  streaks_and_consistency,
  pull_requests,
  repositories_contributed_to,
  languages,
} = stats;

const totalAdditions = lines_of_code.total_additions;
const totalDeletions = lines_of_code.total_deletions;
const netLines = lines_of_code.net_lines;
const totalChurn = totalAdditions + totalDeletions;
const addRatio = totalChurn > 0 ? (totalAdditions / totalChurn) * 100 : 0;
const churnBar = getAsciiBar(addRatio, 16);

const totalReposContributed = repositories_contributed_to?.length || 0;
const publicRepos = repositories.public;
const privateRepos = repositories.private;
const orgRepos = Math.max(
  0,
  totalReposContributed - (publicRepos + privateRepos)
);

const totalCommits =
  repositories_contributed_to?.reduce((sum, r) => sum + (r.commits || 0), 0) ||
  contributions.commits;

const prMergeRate = pull_requests.merge_rate_percentage;
const prBar = getAsciiBar(prMergeRate, 16);

const activeRate = streaks_and_consistency.activity_rate_percentage;
const streakBar = getAsciiBar(activeRate, 16);

const topLanguages =
  (languages || [])
    .slice(0, 3)
    .map((l) => `${l.name} ${Math.round(l.percentage)}%`)
    .join(' · ') || '--';
---

<div
  class="font-mono text-xs w-full max-w-xl text-rp-subtle pt-2 space-y-2.5"
  id="tui-coding-telemetry"
>
  <div class="flex items-center gap-2 text-rp-muted">
    <span class="text-[var(--color-accent)] font-semibold">&gt;</span>
    <span class="text-rp-text font-semibold uppercase tracking-wider text-[11px]">
      Telemetry
    </span>
    <span class="flex-1 border-b border-rp-muted/20"></span>
  </div>

  <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-y-2.5 gap-x-6">
    <div class="space-y-2">
      <div class="flex items-center gap-2 min-w-0">
        <span class="text-rp-muted w-3">&amp;</span>
        <span class="text-rp-subtle w-14 shrink-0">loc:</span>
        <span class="text-rp-text font-medium truncate">
          {fmt.format(netLines)}{' '}
          <span class="text-rp-muted text-[11px] font-normal">
            (+{formatCompact(totalAdditions)} / -{formatCompact(totalDeletions)}
            )
          </span>
        </span>
      </div>

      <div class="flex items-center gap-2 min-w-0">
        <span class="text-rp-muted w-3">%</span>
        <span class="text-rp-subtle w-14 shrink-0">churn:</span>
        <div class="inline-flex items-center gap-2 text-rp-subtle">
          <div class="inline-flex items-center font-mono tracking-tight text-xs">
            <span>[</span>
            <span class="text-rp-pine font-bold">{churnBar.filled}</span>
            <span class="text-rp-muted/40">{churnBar.empty}</span>
            <span>]</span>
          </div>
          <span class="text-rp-text font-medium text-[11px] tabular-nums min-w-[34px] text-right">
            {churnBar.pctFormatted}
          </span>
        </div>
      </div>

      <div class="flex items-center gap-2 min-w-0">
        <span class="text-rp-muted w-3">#</span>
        <span class="text-rp-subtle w-14 shrink-0">repos:</span>
        <span class="text-rp-text font-medium truncate">
          {totalReposContributed}{' '}
          <span class="text-rp-muted text-[11px] font-normal">
            ({publicRepos} public, {privateRepos} private, {orgRepos} org)
          </span>
        </span>
      </div>

      <div class="flex items-center gap-2 min-w-0">
        <span class="text-rp-muted w-3">*</span>
        <span class="text-rp-subtle w-14 shrink-0">commits:</span>
        <span class="text-rp-text font-medium truncate">
          {fmt.format(totalCommits)}
        </span>
      </div>
    </div>

    <div class="space-y-2">
      <div class="flex items-center gap-2 min-w-0">
        <span class="text-rp-muted w-3">+</span>
        <span class="text-rp-subtle w-14 shrink-0">prs:</span>
        <div class="inline-flex items-center gap-2 text-rp-subtle">
          <div class="inline-flex items-center font-mono tracking-tight text-xs">
            <span>[</span>
            <span class="text-rp-foam font-bold">{prBar.filled}</span>
            <span class="text-rp-muted/40">{prBar.empty}</span>
            <span>]</span>
          </div>
          <span class="text-rp-text font-medium text-[11px] tabular-nums min-w-[34px] text-right">
            {prBar.pctFormatted}
          </span>
        </div>
      </div>

      <div class="flex items-center gap-2 min-w-0">
        <span class="text-rp-muted w-3">@</span>
        <span class="text-rp-subtle w-14 shrink-0">active:</span>
        <div class="inline-flex items-center gap-2 text-rp-subtle">
          <div class="inline-flex items-center font-mono tracking-tight text-xs">
            <span>[</span>
            <span class="text-rp-gold font-bold">{streakBar.filled}</span>
            <span class="text-rp-muted/40">{streakBar.empty}</span>
            <span>]</span>
          </div>
          <span class="text-rp-text font-medium text-[11px] tabular-nums min-w-[34px] text-right">
            {streakBar.pctFormatted}
          </span>
        </div>
      </div>

      <div class="flex items-center gap-2 min-w-0">
        <span class="text-rp-muted w-3">^</span>
        <span class="text-rp-subtle w-14 shrink-0">streak:</span>
        <span class="text-rp-text font-medium truncate">
          {streaks_and_consistency.longest_streak_days} days{' '}
          <span class="text-rp-muted text-[11px] font-normal">
            ({streaks_and_consistency.active_days_count} active)
          </span>
        </span>
      </div>

      <div class="flex items-center gap-2 min-w-0">
        <span class="text-rp-muted w-3">$</span>
        <span class="text-rp-subtle w-14 shrink-0">stack:</span>
        <span class="text-rp-text font-medium truncate">{topLanguages}</span>
      </div>
    </div>
  </div>
</div>
