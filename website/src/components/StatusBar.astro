---
import stats from '../../../data/github-stats.json';

const topRepo = (stats.repositories_contributed_to || []).find(
  (r) => !r.is_private && !r.is_fork
) ||
  (stats.repositories_contributed_to || [])[0] || {
    repository: 'pid7-org/turbofox',
    commits: 924,
    description:
      'An embedded, memory-mapped key-value engine providing lock-free concurrency & explicit sync barriers',
  };

const repoName = topRepo.repository.replace(/^.*\//, '');

const topLang = (stats.languages || [])[0] || {
  name: 'C',
  bytes: 5903204,
  percentage: 49.21,
};

const formatBytesCompact = (bytes: number) => {
  if (bytes >= 1_000_000) return `${(bytes / 1_000_000).toFixed(1)}M`;
  if (bytes >= 1_000) return `${(bytes / 1_000).toFixed(1)}k`;
  return `${bytes}`;
};

const formatLocCompact = (lines: number) => {
  if (lines >= 1_000_000) return `${(lines / 1_000_000).toFixed(2)}M`;
  if (lines >= 1_000) return `${(lines / 1_000).toFixed(1)}k`;
  return `${lines}`;
};

const netLoc = stats.lines_of_code?.net_lines || 1574850;
const langBytesFormatted = formatBytesCompact(topLang.bytes);
const netLocFormatted = formatLocCompact(netLoc);
---

<div
  class="font-mono text-xs w-full max-w-xl text-rp-subtle pt-1 space-y-2.5"
  id="tui-telemetry-panel"
>
  <div class="flex items-center gap-2 text-rp-muted">
    <span class="text-[var(--color-accent)] font-semibold">&gt;</span>
    <span class="text-rp-text font-semibold uppercase tracking-wider text-[11px]">
      Status
    </span>
    <span class="flex-1 border-b border-rp-muted/20"></span>
  </div>

  <div class="space-y-1.5 font-mono text-xs">
    <div class="flex flex-wrap items-center gap-1.5 min-w-0">
      <span class="text-rp-muted select-none">[</span>
      <span class="inline-flex items-center gap-1.5 text-[var(--color-accent)] font-semibold">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-[var(--color-accent)] animate-pulse"></span>
        <span>live</span>
      </span>
      <span class="text-rp-muted select-none">]</span>
      <span class="text-rp-muted/50 select-none">─</span>
      <span class="text-rp-muted select-none">[</span>
      <a
        href={`https://github.com/${topRepo.repository}`}
        target="_blank"
        rel="noopener noreferrer"
        class="text-rp-text font-medium hover:text-[var(--color-accent)] transition-colors underline decoration-dotted decoration-rp-muted/50 underline-offset-3"
      >
        {repoName} ({topRepo.commits} commits)
      </a>
      <span class="text-rp-muted select-none">]</span>
      <span class="text-rp-muted/50 select-none">─</span>
      <span class="text-rp-muted select-none">[</span>
      <span class="text-rp-subtle">max loc:</span>
      <span class="text-rp-text font-medium">
        {topLang.name} ({langBytesFormatted} bytes)
      </span>
      <span class="text-rp-muted select-none">]</span>
      <span class="text-rp-muted/50 select-none">─</span>
      <span class="text-rp-muted select-none">[</span>
      <span class="text-rp-text font-medium">{netLocFormatted} net loc</span>
      <span class="text-rp-muted select-none">]</span>
    </div>

    <div class="flex items-center justify-between gap-3 text-[11px] text-rp-muted min-w-0 pt-0.5">
      <div class="flex items-center gap-1.5 min-w-0 truncate">
        <span class="select-none text-rp-muted">└─</span>
        <span class="truncate italic text-rp-subtle">
          "{topRepo.description || 'Core development and systems work'}"
        </span>
      </div>
      <div class="inline-flex items-center gap-1 text-[var(--color-accent)] font-mono shrink-0 select-none">
        <span class="text-rp-muted">[</span>
        <span id="tui-pulse" class="tracking-widest">
          ▰▰▰▰▱
        </span>
        <span class="text-rp-muted">]</span>
      </div>
    </div>
  </div>
</div>

<script>
  const PULSE_FRAMES = [
    '▰▱▱▱▱',
    '▰▰▱▱▱',
    '▰▰▰▱▱',
    '▰▰▰▰▱',
    '▰▰▰▰▰',
    '▱▰▰▰▰',
    '▱▱▰▰▰',
    '▱▱▱▰▰',
    '▱▱▱▱▰',
  ];

  let frameIdx = 0;
  function updatePulse() {
    const pulseEl = document.getElementById('tui-pulse');
    if (pulseEl) {
      frameIdx = (frameIdx + 1) % PULSE_FRAMES.length;
      pulseEl.textContent = PULSE_FRAMES[frameIdx];
    }
  }

  setInterval(updatePulse, 180);
  document.addEventListener('astro:after-swap', updatePulse);
</script>
