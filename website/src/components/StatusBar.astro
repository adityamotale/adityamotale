---
---

<div class="font-mono text-xs w-full max-w-xl text-rp-subtle pt-1 space-y-2.5" id="tui-telemetry-panel">
  <!-- Section Title / Divider -->
  <div class="flex items-center gap-2 text-rp-muted">
    <span class="text-[var(--color-accent)] font-semibold">&gt;</span>
    <span class="text-rp-text font-semibold uppercase tracking-wider text-[11px]">Status</span>
    <span class="flex-1 border-b border-rp-muted/20"></span>
  </div>

  <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-y-2.5 gap-x-6">
    <div class="space-y-2">
    <div class="flex items-center gap-2 min-w-0">
      <span class="text-rp-muted w-3 select-none">~</span>
      <span class="text-rp-subtle w-14 shrink-0 select-none">os:</span>
      <span id="sys-os" class="text-rp-text font-medium truncate">--</span>
    </div>

    <div class="flex items-center gap-2 min-w-0">
      <span class="text-rp-muted w-3 select-none">#</span>
      <span class="text-rp-subtle w-14 shrink-0 select-none">cpu:</span>
      <span id="sys-cpu" class="text-rp-text font-medium truncate">--</span>
    </div>

    <div class="flex items-center gap-2 min-w-0">
      <span class="text-rp-muted w-3 select-none">*</span>
      <span class="text-rp-subtle w-14 shrink-0 select-none">display:</span>
      <span id="sys-display" class="text-rp-text font-medium truncate">--</span>
    </div>
  </div>

  <div class="space-y-2">
    <div class="flex items-center gap-2 min-w-0">
      <span class="text-rp-muted w-3 select-none">@</span>
      <span class="text-rp-subtle w-10 shrink-0 select-none">date:</span>
      <span id="tui-date" class="text-rp-text font-medium truncate">---, -- --- ----</span>
    </div>

    <div class="flex items-center gap-2 min-w-0">
      <span class="text-rp-muted w-3 select-none">+</span>
      <span class="text-rp-subtle w-10 shrink-0 select-none">time:</span>
      <span id="tui-time" class="text-rp-text font-medium truncate">--:--:-- IST +05:30</span>
    </div>

    <div class="flex items-center gap-2 min-w-0">
      <span class="text-rp-muted w-3 select-none">%</span>
      <span class="text-rp-subtle w-10 shrink-0 select-none">day:</span>
      <div class="inline-flex items-center gap-2 text-rp-subtle font-mono">
        <div class="inline-flex items-center font-mono tracking-tight text-xs">
          <span>[</span>
          <span id="tui-bar-filled" class="text-[var(--color-accent)] font-bold">#######</span>
          <span id="tui-bar-empty" class="text-rp-muted/40">.........</span>
          <span>]</span>
        </div>
        <span id="tui-pct" class="text-rp-text font-medium text-[11px] tabular-nums min-w-[34px] text-right">--.-%</span>
      </div>
    </div>
  </div>
  </div>
</div>

<script>
  const BAR_LENGTH = 16;
  const FILLED_GLYPH = '#';
  const EMPTY_GLYPH = '.';

  function getOsInfo(): string {
    const userAgent = navigator.userAgent;
    if (userAgent.includes('Macintosh') || userAgent.includes('Mac OS')) return 'macOS';
    if (userAgent.includes('Windows')) return 'Windows';
    if (userAgent.includes('Android')) return 'Android';
    if (userAgent.includes('iPhone') || userAgent.includes('iPad')) return 'iOS';
    return 'Linux';
  }

  function getCpuArch(): string {
    const userAgent = navigator.userAgent;
    if (userAgent.includes('x86_64') || userAgent.includes('x64') || userAgent.includes('Win64')) {
      return 'x86_64 (64-bit)';
    } else if (userAgent.includes('arm64') || userAgent.includes('aarch64') || navigator.maxTouchPoints > 0) {
      return 'ARM64 (64-bit)';
    }
    return (navigator as any).platform || '64-bit CPU';
  }

  function getDisplayInfo(): string {
    const w = window.screen.width;
    const h = window.screen.height;
    const dpr = window.devicePixelRatio || 1;
    return dpr > 1 ? `${w}×${h} @${dpr}x` : `${w}×${h}`;
  }

  async function updateSystemMetrics() {
    const osEl = document.getElementById('sys-os');
    const cpuEl = document.getElementById('sys-cpu');
    const displayEl = document.getElementById('sys-display');

    if (osEl) osEl.textContent = getOsInfo();
    if (cpuEl) cpuEl.textContent = getCpuArch();
    if (displayEl) displayEl.textContent = getDisplayInfo();
  }

  function updateStatusMetrics() {
    const dateEl = document.getElementById('tui-date');
    const timeEl = document.getElementById('tui-time');
    const pctEl = document.getElementById('tui-pct');
    const filledEl = document.getElementById('tui-bar-filled');
    const emptyEl = document.getElementById('tui-bar-empty');

    if (!pctEl || !filledEl || !emptyEl) return;

    const now = new Date();
    if (dateEl) {
      const formatterDate = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Asia/Kolkata',
        weekday: 'short',
        day: '2-digit',
        month: 'short',
        year: 'numeric'
      });
      dateEl.textContent = formatterDate.format(now);
    }

    const formatterTime = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Asia/Kolkata',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false
    });

    if (timeEl) {
      timeEl.textContent = `${formatterTime.format(now)} IST +05:30`;
    }

    const parts = formatterTime.formatToParts(now);
    const hour = parseInt(parts.find((p) => p.type === 'hour')?.value || '0', 10);
    const minute = parseInt(parts.find((p) => p.type === 'minute')?.value || '0', 10);
    const second = parseInt(parts.find((p) => p.type === 'second')?.value || '0', 10);

    const totalSecondsInDay = 86400;
    const currentSeconds = hour * 3600 + minute * 60 + second;
    const percentage = (currentSeconds / totalSecondsInDay) * 100;

    pctEl.textContent = `${percentage.toFixed(1)}%`;
    const filledCount = Math.min(BAR_LENGTH, Math.floor((percentage / 100) * BAR_LENGTH));
    const emptyCount = BAR_LENGTH - filledCount;

    filledEl.textContent = FILLED_GLYPH.repeat(filledCount);
    emptyEl.textContent = EMPTY_GLYPH.repeat(emptyCount);
  }

  function initTelemetry() {
    updateSystemMetrics();
    updateStatusMetrics();
  }

  initTelemetry();
  setInterval(updateStatusMetrics, 1000);
  setInterval(updateSystemMetrics, 30000);

  window.addEventListener('resize', updateSystemMetrics);
  document.addEventListener('astro:after-swap', initTelemetry);
</script>
