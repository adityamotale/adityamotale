---
import stats from '../../../data/github-stats.json';

const fmt = new Intl.NumberFormat('en-US');
const formatCompact = (n: number) => {
  if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1)}M`;
  if (n >= 1_000) return `${(n / 1_000).toFixed(1)}k`;
  return n.toString();
};

const BAR_LENGTH = 16;
const FILLED_GLYPH = '#';
const EMPTY_GLYPH = '.';

function getAsciiBar(pct: number, len = BAR_LENGTH) {
  const safePct = Math.max(0, Math.min(100, pct));
  const filled = Math.min(len, Math.floor((safePct / 100) * len));
  const empty = len - filled;
  return {
    filled: FILLED_GLYPH.repeat(filled),
    empty: EMPTY_GLYPH.repeat(empty),
    pctFormatted: `${safePct.toFixed(1)}%`
  };
}

// Compute target previous calendar month (e.g. August 2026 if current is September 2026)
const now = new Date();
const lastMonthDate = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth() - 1, 1));
const year = lastMonthDate.getUTCFullYear();
const monthIndex = lastMonthDate.getUTCMonth();
const monthPrefix = `${year}-${String(monthIndex + 1).padStart(2, '0')}`;
const totalDaysInMonth = new Date(Date.UTC(year, monthIndex + 1, 0)).getUTCDate();

const dailyEntries = Object.entries(stats.daily_contributions || {})
  .filter(([date]) => date.startsWith(monthPrefix))
  .sort(([a], [b]) => a.localeCompare(b));

let activeDays = 0;
let longestStreak = 0;
let tempStreak = 0;

for (const [_, count] of dailyEntries) {
  if (count > 0) {
    activeDays++;
    tempStreak++;
    if (tempStreak > longestStreak) longestStreak = tempStreak;
  } else {
    tempStreak = 0;
  }
}

const activeRate = totalDaysInMonth > 0 ? (activeDays / totalDaysInMonth) * 100 : 0;
const streakBar = getAsciiBar(activeRate, 16);

// Last month figures (August 2026)
const monthlyAdditions = 28973;
const monthlyDeletions = 8972;
const monthlyNetLines = monthlyAdditions - monthlyDeletions;
const totalChurn = monthlyAdditions + monthlyDeletions;
const addRatio = totalChurn > 0 ? (monthlyAdditions / totalChurn) * 100 : 0;
const churnBar = getAsciiBar(addRatio, 16);

const monthlyCommits = 309;
const monthlyRepos = { total: 1, public: 0, private: 0, org: 1 };
const monthlyPrs = { merged: 0, total: 0, rate: 0 };
const prBar = getAsciiBar(monthlyPrs.rate, 16);
const topStack = 'C 100%';
---

<div class="font-mono text-xs w-full max-w-xl text-rp-subtle pt-2 space-y-2.5" id="tui-monthly-telemetry">
  <div class="flex items-center gap-2 text-rp-muted">
    <span class="text-[var(--color-accent)] font-semibold">&gt;</span>
    <span class="text-rp-text font-semibold uppercase tracking-wider text-[11px]">Last Month</span>
    <span class="flex-1 border-b border-rp-muted/20"></span>
  </div>

  <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-y-2.5 gap-x-6">
    <div class="space-y-2">
      <div class="flex items-center gap-2 min-w-0">
        <span class="text-rp-muted w-3">&amp;</span>
        <span class="text-rp-subtle w-14 shrink-0">loc:</span>
        <span class="text-rp-text font-medium truncate">
          {fmt.format(monthlyNetLines)} <span class="text-rp-muted text-[11px] font-normal">(+{formatCompact(monthlyAdditions)} / -{formatCompact(monthlyDeletions)})</span>
        </span>
      </div>

      <div class="flex items-center gap-2 min-w-0">
        <span class="text-rp-muted w-3">%</span>
        <span class="text-rp-subtle w-14 shrink-0">churn:</span>
        <div class="inline-flex items-center gap-2 text-rp-subtle">
          <div class="inline-flex items-center font-mono tracking-tight text-xs">
            <span>[</span>
            <span class="text-rp-pine font-bold">{churnBar.filled}</span>
            <span class="text-rp-muted/40">{churnBar.empty}</span>
            <span>]</span>
          </div>
          <span class="text-rp-text font-medium text-[11px] tabular-nums min-w-[34px] text-right">{churnBar.pctFormatted}</span>
        </div>
      </div>

      <div class="flex items-center gap-2 min-w-0">
        <span class="text-rp-muted w-3">#</span>
        <span class="text-rp-subtle w-14 shrink-0">repos:</span>
        <span class="text-rp-text font-medium truncate">
          {monthlyRepos.total} <span class="text-rp-muted text-[11px] font-normal">({monthlyRepos.public} public, {monthlyRepos.private} private, {monthlyRepos.org} org)</span>
        </span>
      </div>

      <div class="flex items-center gap-2 min-w-0">
        <span class="text-rp-muted w-3">*</span>
        <span class="text-rp-subtle w-14 shrink-0">commits:</span>
        <span class="text-rp-text font-medium truncate">
          {fmt.format(monthlyCommits)}
        </span>
      </div>
    </div>

    <div class="space-y-2">
      <div class="flex items-center gap-2 min-w-0">
        <span class="text-rp-muted w-3">+</span>
        <span class="text-rp-subtle w-14 shrink-0">prs:</span>
        <div class="inline-flex items-center gap-2 text-rp-subtle">
          <div class="inline-flex items-center font-mono tracking-tight text-xs">
            <span>[</span>
            <span class="text-rp-foam font-bold">{prBar.filled}</span>
            <span class="text-rp-muted/40">{prBar.empty}</span>
            <span>]</span>
          </div>
          <span class="text-rp-text font-medium text-[11px] tabular-nums min-w-[34px] text-right">{monthlyPrs.merged}/{monthlyPrs.total}</span>
        </div>
      </div>

      <div class="flex items-center gap-2 min-w-0">
        <span class="text-rp-muted w-3">@</span>
        <span class="text-rp-subtle w-14 shrink-0">active:</span>
        <div class="inline-flex items-center gap-2 text-rp-subtle">
          <div class="inline-flex items-center font-mono tracking-tight text-xs">
            <span>[</span>
            <span class="text-rp-gold font-bold">{streakBar.filled}</span>
            <span class="text-rp-muted/40">{streakBar.empty}</span>
            <span>]</span>
          </div>
          <span class="text-rp-text font-medium text-[11px] tabular-nums min-w-[34px] text-right">{streakBar.pctFormatted}</span>
        </div>
      </div>

      <div class="flex items-center gap-2 min-w-0">
        <span class="text-rp-muted w-3">^</span>
        <span class="text-rp-subtle w-14 shrink-0">streak:</span>
        <span class="text-rp-text font-medium truncate">
          {longestStreak} days <span class="text-rp-muted text-[11px] font-normal">({activeDays} active)</span>
        </span>
      </div>

      <div class="flex items-center gap-2 min-w-0">
        <span class="text-rp-muted w-3">$</span>
        <span class="text-rp-subtle w-14 shrink-0">stack:</span>
        <span class="text-rp-text font-medium truncate">
          {topStack}
        </span>
      </div>
    </div>
  </div>
</div>
