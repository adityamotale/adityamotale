---
import { formatBlogDate, getRecentWriting } from '../lib/blog';

const writingList = await getRecentWriting(5);
---

{writingList.length > 0 && (
  <div
    id="tui-writing"
    class="w-full font-mono text-[11px] sm:text-xs leading-relaxed"
  >
    <div class="w-full flex flex-col font-mono">
      {/* Section Header: > WRITING ────── [view all] ── */}
      <div class="w-full flex items-center overflow-hidden mb-2">
        <span class="text-[var(--color-accent)] font-semibold shrink-0">
          &gt;&nbsp;
        </span>
        <span class="font-bold tracking-wider text-rp-text uppercase shrink-0">
          WRITING
        </span>
        <span class="mx-2 flex-1 border-b border-rp-muted/20" />
        <a
          href="/blog"
          class="shrink-0 text-rp-subtle hover:text-[var(--color-accent)] transition-colors text-[11px] font-mono lowercase"
        >
          [view all]
        </a>
        <span class="ml-2 w-3 sm:w-4 border-b border-rp-muted/20 shrink-0" />
      </div>

      {/* Section comment */}
      <div class="text-[11px] text-rp-muted/70 pl-3">
        <span>// recent posts</span>
      </div>

      {/* Posts list */}
      <div class="pl-3 py-1 flex flex-col space-y-1.5">
        {writingList.map((item) => (
          <div class="group flex items-baseline justify-between gap-3 border-b border-rp-muted/10 py-1 last:border-0">
            <a
              href={item.url}
              target={item.isExternal ? '_blank' : undefined}
              rel={item.isExternal ? 'noopener noreferrer' : undefined}
              class="text-rp-subtle hover:text-[var(--color-accent)] transition-colors underline decoration-dotted decoration-rp-muted/50 underline-offset-3 leading-snug flex-1 truncate select-text"
            >
              {item.title}
            </a>
            <span class="shrink-0 text-rp-muted text-[11px] font-mono">
              {formatBlogDate(item.dateStr)}
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>
)}
