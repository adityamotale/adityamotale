{
  "name": "website",
  "type": "module",
  "version": "0.3.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build:resume": "node scripts/generate-resume-pdf.js",
    "build": "node scripts/generate-resume-pdf.js && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test",
    "format": "prettier --write \"src/**/*.{astro,ts,css,js,mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,css,js,mjs,json}\""
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@rose-pine/palette": "^4.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/katex": "^0.16.8",
    "katex": "^0.18.7",
    "mdparser": "file:../mdparser",
    "prettier": "^3.9.7",
    "prettier-plugin-astro": "^1.0.1"
  }
}
